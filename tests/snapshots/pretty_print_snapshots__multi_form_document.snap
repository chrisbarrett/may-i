---
source: tests/pretty_print_snapshots.rs
assertion_line: 394
expression: out
---
(safe-env-vars "HOME" "USER")


(define safe-cmd
  (or (positional "status") (positional "log")))


(parser "kubectl" (style gnu) (parameter ["n" "namespace"]))


(rule "ls"
  (allow))


(rule "rm"
  (cond
    ((positional "/")
     (deny "root"))
    ((flag "r")
     (ask "recursive"))
    (else
     (allow))))


(check (allow "ls -la") (deny "rm -rf /"))
