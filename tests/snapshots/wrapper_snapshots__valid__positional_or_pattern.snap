    Wrapper {
        command: "x",
        steps: [
            Positional {
                patterns: [
                    WrapperPattern {
                        expr: Or(
                            [
                                Literal(
                                    "foo",
                                ),
                                Literal(
                                    "bar",
                                ),
                            ],
                        ),
                        bind_fact: None,
                    },
                ],
                capture: true,
            },
        ],
    },
]
